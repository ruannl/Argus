# Runtime-only backend configuration. Values are server-side only.
# Copy this file to `.env` (git-ignored) for local development; the backend
# loads `backend/.env` at startup. Real environment variables always win.
#
# Use the restricted runtime login. Owner, migrator, administrator and
# test-maintenance credentials belong in `.env.maintenance`/`.env.test` or a
# per-child process environment, never in this file.
ARGUS_DATABASE_URL=postgres://argus_runtime:<password>@127.0.0.1:5432/argus?search_path=public
ARGUS_HOST=127.0.0.1
ARGUS_PORT=3001

# Generate a secret with: openssl rand -hex 32
# The backend refuses to start when this is absent or shorter than 32 bytes.
ARGUS_API_SECRET=

# Exact frontend origin used for the CORS allowlist and trusted server calls.
# Must match ARGUS_FRONTEND_URL in frontend/.env exactly.
ARGUS_FRONTEND_URL=http://127.0.0.1:3000

# Logging accepts only the closed values shown below. The Docker image overrides
# the format to json; local development defaults to pretty output.
ARGUS_LOG_LEVEL=info
ARGUS_LOG_FORMAT=pretty

# Resend is required at runtime and is server-side only. The API key must be at least
# 20 bytes; the sender must be a local@domain mailbox.
ARGUS_RESEND_API_KEY=
ARGUS_RESEND_FROM=local@example.com

# Billing webhook signing secret (mock provider: HMAC-SHA256 of the payload).
# At least 32 bytes; generate with: openssl rand -hex 32
ARGUS_BILLING_WEBHOOK_SECRET=
