# Maintenance-only connection for the explicit migrate and seed commands.
# This file is git-ignored and is read only by those commands. The normal web
# host never reads it. The migrator login must be allowed to SET ROLE to the
# owner role; the URL below makes that assumption explicit.
ARGUS_DATABASE_URL=postgres://argus_migrator:<password>@127.0.0.1:5432/argus?search_path=public&role=argus_owner

# Optional: pin the seeded account passwords instead of generating them.
# ARGUS_SEED_DEV_PASSWORD=
# ARGUS_SEED_USER_PASSWORD=
