# All values below are server-only. Do not use a NEXT_PUBLIC_ prefix.

# C# backend origin used by the server-only backend client.
ARGUS_BACKEND_URL=http://127.0.0.1:3001

# At least 32 bytes. Generate with: openssl rand -hex 32
ARGUS_API_SECRET=

# Exact public Next.js origin sent by trusted server-side calls.
ARGUS_FRONTEND_URL=http://127.0.0.1:3000

# Auth.js JWT encryption secret. At least 32 bytes; generate with: openssl rand -hex 32
ARGUS_AUTH_SECRET=

# Auth.js host trust. "true" trusts the request Host header (local dev, WSL, or
# behind a trusted proxy that sets X-Forwarded-Host). Leave unset/false in
# production; then AUTH_URL must be the public origin and mismatched hosts are rejected.
ARGUS_AUTH_TRUST_HOST=true
